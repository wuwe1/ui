{
	"name": "@wuwe1/ui",
	"version": "0.0.0",
	"description": "Shared components for wuwe1's projects: a theme of derived design tokens, base components, AI product components",
	"license": "MIT",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wuwe1/ui.git"
	},
	"packageManager": "pnpm@10.18.3",
	"engines": {
		"node": "^22.18.0 || >=23.6.0"
	},
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./styles.css": "./src/styles.css",
		"./theme.css": "./src/theme/theme.css",
		"./tokens.css": "./src/theme/tokens.css",
		"./variants.css": "./src/theme/variants.css",
		"./base.css": "./src/theme/base.css",
		"./theme": "./src/theme/index.ts",
		"./lib/*": "./src/lib/*.ts",
		"./hooks/*": "./src/hooks/*.ts",
		"./*": "./src/components/*.tsx"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"check": "tsc --noEmit",
		"test": "node --test 'test/*.test.ts'",
		"gen": "node scripts/gen-theme.ts"
	},
	"peerDependencies": {
		"react": "^19",
		"react-dom": "^19",
		"tailwindcss": "^4"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"cmdk": "^1.1.1",
		"cn": "^0.4.0",
		"lucide-react": "^1.52.0",
		"radix-ui": "^1.6.7",
		"react-resizable-panels": "^4.14.2",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.2"
	}
}
