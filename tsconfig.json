{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"jsx": "react-jsx",
		"lib": ["esnext", "dom", "dom.iterable"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["vite/client", "node"]
	},
	"include": ["src", "showcase", "scripts", "test", "vite.config.ts"]
}
